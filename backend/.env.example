# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Session ----
# Signs OUR OWN session token (issued after Google OAuth + role lookup). Not a Google secret.
SESSION_JWT_SECRET=replace_this_with_a_long_random_string
SESSION_JWT_EXPIRES_IN=7d

# ---- PostgreSQL ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adaptive_learning_dashboard

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Google OAuth 2.0 / Classroom API ----
# Required for real "Sign in with Google" + Classroom sync. See docs/SETUP_GUIDE.md.
# We use the popup-based "auth code" flow (@react-oauth/google), which requires the token
# exchange redirect_uri to literally be the string "postmessage" — this is set in code
# (backend/src/services/googleAuthService.js), not here. GOOGLE_REDIRECT_URI below is only
# used if you switch to the full-page redirect flow instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# ---- Gemini (AI-generated feedback for at-risk students only, model: "gemini-3.6-flash") ----
GEMINI_API_KEY=

# ---- AI feedback cache TTL (hours) ----
AI_FEEDBACK_TTL_HOURS=72

# ---- Dev-only bypass login ----
# When NODE_ENV=development, /auth/dev-login lets you pick a seeded demo user without a real
# Google Workspace account. This route is hard-disabled (404) whenever NODE_ENV=production.
DEV_LOGIN_ENABLED=true
